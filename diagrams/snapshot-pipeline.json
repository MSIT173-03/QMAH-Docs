    {"id": "seed-users", "label": "seed-showcase-users", "description": "建立展示用帳號與角色", "kind": "process", "group": "build-isolated", "position": {"x": 280, "y": 340}, "size": {"width": 360, "height": 76}},
    {"id": "showcase-data", "label": "generate-showcase-data", "description": "產生可重複的展示資料", "kind": "process", "group": "build-isolated", "position": {"x": 280, "y": 470}, "size": {"width": 360, "height": 76}},
    {"id": "validate", "label": "結構／關聯／資料品質驗證", "description": "輸出前的檢查關卡", "kind": "process", "group": "validate-export", "position": {"x": 280, "y": 660}, "size": {"width": 360, "height": 76}},
