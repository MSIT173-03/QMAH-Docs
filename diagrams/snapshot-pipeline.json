    {"id": "validate-export-label", "label": "驗證與交付", "kind": "note", "group": "validate-export", "position": {"x": 80, "y": 660}, "size": {"width": 140, "height": 36}, "style": {"fill": "#f8fafc", "stroke": "#64748b", "font": "#111827", "rounded": true}},
