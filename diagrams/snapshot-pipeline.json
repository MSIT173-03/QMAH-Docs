    {"id": "restore", "label": "本機 QMAH 副本", "description": "依本機設定自動尋找或指定資料庫", "kind": "database", "group": "local-use", "position": {"x": 280, "y": 1100}, "size": {"width": 360, "height": 76}},
    {"id": "applications", "label": "QMAH.Web／QMAH.Api／QMAH.Client", "description": "使用同一份本機資料基線", "kind": "service", "group": "local-use", "position": {"x": 280, "y": 1230}, "size": {"width": 360, "height": 76}}
