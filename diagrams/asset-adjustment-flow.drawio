<mxfile host="drawio"><diagram id="asset-adjustment-flow" name="管理員增加兩把鑰匙"><mxGraphModel background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="管理員增加兩把鑰匙" style="text;html=1;fontFamily=Microsoft JhengHei;fontSize=26;fontStyle=1;fontColor=#243b40;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="640" height="50" as="geometry"/></mxCell><mxCell id="step-0" value="輸入操作&lt;br>會員、鑰匙、增加 2 把、活動補發原因" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="640" height="110" as="geometry"/></mxCell><mxCell id="edge-0" value="" source="step-0" target="step-1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#3f7074;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="step-1" value="驗證條件&lt;br>登入管理員 ID／原因／啟用鑰匙／餘額範圍" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="640" height="110" as="geometry"/></mxCell><mxCell id="edge-1" value="" source="step-1" target="step-2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#3f7074;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="step-2" value="同一交易保存&lt;br>UserKeyBalances：3 → 5&lt;br>KeyTransactions：+2、原因、管理員 ID" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="640" height="110" as="geometry"/></mxCell><mxCell id="edge-2" value="" source="step-2" target="step-3" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#3f7074;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="step-3" value="提交並回傳&lt;br>成功才顯示新餘額；未提交則回復" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="640" height="110" as="geometry"/></mxCell><mxCell id="edge-3" value="" source="step-3" target="step-4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#3f7074;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="step-4" value="查帳&lt;br>背包查數量；流水查來源；AuditLogs 查管理操作" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="640" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>