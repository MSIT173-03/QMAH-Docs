<mxfile host="drawio"><diagram id="asset-ledger-map" name="資產紀錄：每張表回答什麼"><mxGraphModel background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="資產紀錄：每張表回答什麼" style="text;html=1;fontFamily=Microsoft JhengHei;fontSize=26;fontStyle=1;fontColor=#243b40;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="640" height="50" as="geometry"/></mxCell><mxCell id="step-0" value="現在有多少&lt;br>PointBalances／UserKeyBalances／KeyProgressBalances" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="640" height="110" as="geometry"/></mxCell><mxCell id="step-1" value="何時、為何加扣&lt;br>PointTransactions／KeyTransactions／KeyProgressTransactions&lt;br>Amount、Reason、ReferenceType、ReferenceId" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="640" height="110" as="geometry"/></mxCell><mxCell id="step-2" value="哪張券、誰發或撤銷&lt;br>UserCoupons：IssuedAt／ExpiresAt／Status&lt;br>IssuedByAdminUserId／RevokedByAdminUserId" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="640" height="110" as="geometry"/></mxCell><mxCell id="step-3" value="哪次批次活動&lt;br>EconomyAdjustmentBatches：篩選條件、管理員、結果&lt;br>券以 GrantBatchId／RevokeBatchId 回查" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="640" height="110" as="geometry"/></mxCell><mxCell id="step-4" value="管理員從哪裡操作&lt;br>AuditLogs：操作者、Controller、Action、HTTP 結果" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#243b40;fillColor=#eef5f3;strokeColor=#6b9494;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="640" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>